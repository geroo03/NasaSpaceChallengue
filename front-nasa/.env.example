# SOLO SERVIDOR. No agregar VITE_ a estas variables.
# Token de usuario Earthdata: descarga directa de COG y extracción del píxel (sin AppEEARS).
EARTHDATA_TOKEN=
# Elegir un token de AppEEARS (no un token genérico de Earthdata):
APPEEARS_TOKEN=
# O configurar usuario y contraseña de Earthdata para obtener el token automáticamente:
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Secreto largo para firmar las referencias temporales a tareas (recomendado).
APPEEARS_JOB_SECRET=

# ── Backend AgroField (api/v1) ── SOLO SERVIDOR, sin VITE_:
SUPABASE_URL=
# Service role key: da acceso total a la base. Nunca al navegador ni al repo.
SUPABASE_SERVICE_ROLE_KEY=
# ── Navegador (ingreso por link al mail). La anon key es pública por diseño; RLS protege los datos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
